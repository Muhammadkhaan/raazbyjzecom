# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Hostinger MySQL / MariaDB database connection string
# Configure in Hostinger hPanel > MySQL Databases
# Format: mysql://<username>:<password>@<hostinger_mysql_host>:3306/<database_name>
DATABASE_URL="mysql://u123456789_laamuser:SecurePassword123!@sql123.main-hosting.eu:3306/u123456789_laamdb"
