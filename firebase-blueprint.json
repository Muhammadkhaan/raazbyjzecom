{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role, email, and display name",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "STAFF", "CUSTOMER"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "Category": {
      "title": "Category",
      "description": "Store collection category",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "sortOrder": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["name", "slug"]
    },
    "Product": {
      "title": "Product",
      "description": "Store apparel or accessory product",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "categoryId": { "type": "string" },
        "regularPrice": { "type": "number" },
        "salePrice": { "type": "number" },
        "status": { "type": "string", "enum": ["DRAFT", "PUBLISHED", "ARCHIVED"] },
        "isFeatured": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "slug", "regularPrice", "status"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string" },
        "userId": { "type": "string" },
        "customerEmail": { "type": "string" },
        "grandTotal": { "type": "number" },
        "paymentStatus": { "type": "string" },
        "fulfillmentStatus": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderNumber", "customerEmail", "grandTotal", "paymentStatus"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual user record and role assignment"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Product collection categories"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Store products with pricing and stock"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders"
    }
  }
}
